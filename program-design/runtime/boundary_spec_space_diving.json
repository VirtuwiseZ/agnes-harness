        "mach_supersonic_min": 1.25
      },
      "expectation": "zero"
    },
    {
      "name": "mass -> very large: peak |a| should approach 1 g",
      "params": {
        "z0_m": 20000.0,
        "m_kg": 190000.0,
        "CD_subsonic": 1.0,
        "CD_transonic": 5.0,
        "CD_final_subsonic": 1.2,
        "A_subsonic_m2": 0.18,
        "A_supersonic_m2": 0.2,
        "mach_subsonic_max": 0.8,
        "mach_supersonic_min": 1.25
      },
      "expectation": "bounded_by:1.5"
    },
    {
      "name": "mass -> very small: peak |a| should stay finite (bounded ~1 g by terminal-velocity argument)",
      "params": {
        "z0_m": 20000.0,
        "m_kg": 0.19,
        "CD_subsonic": 1.0,
        "CD_transonic": 5.0,
        "CD_final_subsonic": 1.2,
        "A_subsonic_m2": 0.18,
        "A_supersonic_m2": 0.2,
        "mach_subsonic_max": 0.8,
        "mach_supersonic_min": 1.25
      },
      "expectation": "finite"
    },
    {
      "name": "sweep-range top (150 km release): finite",
      "params": {
        "z0_m": 150000.0,
        "m_kg": 190.0,
        "CD_subsonic": 1.0,
        "CD_transonic": 5.0,
        "CD_final_subsonic": 1.2,
        "A_subsonic_m2": 0.18,
        "A_supersonic_m2": 0.2,
        "mach_subsonic_max": 0.8,
        "mach_supersonic_min": 1.25
      },
      "expectation": "finite"
    },
    {
      "name": "CD -> infinity proxy (extreme drag): peak |a| should stay finite",
      "params": {
        "z0_m": 20000.0,
        "m_kg": 190.0,
        "CD_subsonic": 10000.0,
        "CD_transonic": 10000.0,
        "CD_final_subsonic": 10000.0,
        "A_subsonic_m2": 0.18,
        "A_supersonic_m2": 0.2,
        "mach_subsonic_max": 0.8,
        "mach_supersonic_min": 1.25
      },
      "expectation": "finite"
    },
    {
      "name": "CD -> 0 (zero drag, pure free fall): peak |a| should approach 1 g from below",
      "params": {
        "z0_m": 20000.0,
        "m_kg": 190.0,
        "CD_subsonic": 0.0,
        "CD_transonic": 0.0,
        "CD_final_subsonic": 0.0,
        "A_subsonic_m2": 0.18,
        "A_supersonic_m2": 0.2,
        "mach_subsonic_max": 0.8,
        "mach_supersonic_min": 1.25
