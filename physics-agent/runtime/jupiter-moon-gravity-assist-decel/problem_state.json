{
  "schema_version": 1,
  "task": {
    "problem_id": "jupiter-moon-gravity-assist-decel",
    "description": "当探测器抵达外层行星（如木星）时，必须减速才能进入轨道，这一过程会消耗大量燃料。有观点认为，抵达木星的航天器可利用木星的卫星实施引力助推机动来减速，从而节省燃料。请评估，对于一个以20公里/秒的速度抵达木星（接近木星系统）的航天器，能否通过该策略实现显著的燃料节省。",
    "target_quantity": "利用木星卫星（伽利略四大卫星）实施单次/多次引力助推的最大理论减速量 Δv_max，以及该策略相比于 20 km/s 入射速度下捕获所需推进剂减速量的相对节省比例与可行性判定",
    "safety_constraints_ref": "N/A（天体动力学与轨道力学理论评估题，约束条件为飞掠高度不得低于卫星表面物理半径 r_p >= R_moon）"
  },
  "session_key": "3bc1409c-268f-4bef-8327-abadb62304ab",
  "stage": "node_2_7_charting",
  "quota": {
    "downstream_retries_remaining": 3,
    "note": "Decrement once per code-edit + re-run cycle inside node_2b_modeling; at 0 with no convergence, trigger annealing rollback to hypothesis_layer."
  },
  "hypothesis_layer": {
    "model_form": "二体圆限制性三体飞掠微扰模型（Patched Conic Approximation）与奥伯斯特效应（Oberth Effect）闭合轨道捕获动力学",
    "assumptions": {
      "H1": "木星与卫星均为球对称质点，卫星绕木星做正圆开普勒轨道运动",
      "H2": "拼接圆锥曲线近似（Patched Conics）：航天器在木星影响球内按木星为中心的开普勒双曲线运动；进入卫星希尔球（Hill sphere）/影响球（SOI）后，瞬时切换为卫星质心坐标系下的双曲线飞掠",
      "H3": "卫星飞掠期间卫星速度矢量大小与方向保持不变（瞬时冲量近似 / 脉冲渐近飞掠）",
      "H4": "飞掠近拱点安全边界：最近飞掠距离受卫星表面半径物理限制，即 r_p >= R_moon",
      "H5": "最优减速构型：航天器从卫星公转轨道前方（Leading edge）切向掠过，使飞掠转角产生相对于木星质心的最大负向速度增量 Δv_J"
    },
    "last_known_good_version": null
  },
  "dimensional_table": {
    "v_inf": "kilometer / second",
    "mu_J": "kilometer ** 3 / second ** 2",
    "mu_moon": "kilometer ** 3 / second ** 2",
    "r_p": "kilometer",
    "delta": "dimensionless",
    "Delta_v": "kilometer / second"
  },
  "internal_prior": {
    "dominant_regime": "在 v_inf = 20 km/s 的超双曲入射条件下，航天器到达各卫星轨道时的木星质心速度高达 25~35 km/s，相对卫星的渐近双曲速度 v_inf,rel 至少在 15~25 km/s 量级。由于卫星质量较小（最大木卫三引力常数仅约 9888 km^3/s^2），其对高速穿过的航天器引力偏折角 delta 极小（通常在 1°~2° 以内），单次飞掠提供的最大绝对速度增量只有约 0.3~0.5 km/s。而航天器进入木星闭合轨道所需的速度减速量在 3.3~11 km/s 以上。因此单次卫星飞掠无法实现显著燃料节省，且单次飞掠无法实现自捕获，未被捕获前无法执行多次飞掠。",
    "expected_order_of_magnitude": "单次飞掠最大减速量约 0.3 - 0.5 km/s，捕获所需最小减速量约 3.3 km/s（近木点）至 7-11 km/s（卫星轨道高度），燃料节省比例在极端乐观下不超过 5% - 10%，工程上无法实现显著节省。"
  },
